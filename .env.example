TELEGRAM_BOT_TOKEN=123456:replace-me
# Defaults to the real Telegram API. Override only for local E2E tests.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Optional comma-separated Telegram chat ids. Leave blank for local experiments only.
TELEGRAM_ALLOWED_CHAT_IDS=

# Command OpenKaren runs for development turns. The user prompt is passed on stdin.
# Set OPENKAREN_AGENT_MODE=relay to spawn coding agents through agent-relay instead.
# Example:
# OPENKAREN_AGENT_COMMAND=codex exec --cd /Users/khaliqgant/Projects/AgentWorkforce/openkaren
OPENKAREN_AGENT_MODE=relay
OPENKAREN_AGENT_COMMAND=
OPENKAREN_AGENT_CWD=/Users/khaliqgant/Projects/AgentWorkforce/openkaren
OPENKAREN_AGENT_TIMEOUT_MS=900000

# agent-relay mode. Requires the selected CLI, usually Codex, to be installed
# and authenticated on this machine.
OPENKAREN_AGENT_RELAY_CLI=codex
OPENKAREN_AGENT_RELAY_MODEL=
OPENKAREN_AGENT_RELAY_CHANNEL=openkaren-dev
OPENKAREN_AGENT_RELAY_WORKFLOW=orchestrated
OPENKAREN_AGENT_RELAY_NAME_PREFIX=OpenKarenCoder
OPENKAREN_AGENT_RELAY_IDLE_THRESHOLD_SECONDS=20
OPENKAREN_AGENT_RELAY_PROGRESS_INTERVAL_MS=120000

# Relaycast webhook surface. Telegram remains the primary human surface.
# This listener also serves /webhooks/inbox for n8n/Pipedream/Composio-style events.
OPENKAREN_RELAYCAST_ENABLED=false
OPENKAREN_RELAYCAST_HOST=127.0.0.1
OPENKAREN_RELAYCAST_PORT=7528
OPENKAREN_RELAYCAST_WEBHOOK_PATH=/webhooks/relaycast
OPENKAREN_RELAYCAST_WEBHOOK_SECRET=

# Relayfile integration filesystem.
OPENKAREN_RELAYFILE_MOUNT_DIR=relayfile-mount
OPENKAREN_RELAYFILE_WORKSPACE=openkaren
OPENKAREN_RELAYFILE_BASE_URL=
OPENKAREN_RELAYFILE_TOKEN=

# RelayCron proactive scheduler.
OPENKAREN_RELAYCRON_BASE_URL=
OPENKAREN_RELAYCRON_API_KEY=
# RelayCron calls this URL every 2 minutes while a relay coding turn is active.
# The same path receives daily-standup, weekly-spend-review, and workflow-health-check ticks.
OPENKAREN_RELAYCRON_WEBHOOK_URL=

# Local token dashboard served by the OpenKaren HTTP listener.
OPENKAREN_DASHBOARD_ENABLED=true
OPENKAREN_DASHBOARD_PATH=/dashboard

# Durable state. Mac mini mode talks to a Cloudflare Worker proxy for KarenUserDO.
OPENKAREN_STATE_WORKER_URL=
OPENKAREN_STATE_AUTH_TOKEN=
OPENKAREN_STATE_USER_ID=local

# Slack surface. Nango should own the OAuth connection; SLACK_BOT_TOKEN is the
# runtime bot token resolved from that connection for local development.
OPENKAREN_SLACK_ENABLED=false
OPENKAREN_SLACK_SIGNING_SECRET=
OPENKAREN_SLACK_ALLOWED_CHANNEL_IDS=
OPENKAREN_SLACK_BOT_TOKEN=
OPENKAREN_SLACK_WEBHOOK_PATH=/webhooks/slack

# Ricky and Workforce.
OPENKAREN_WORKFORCE_PERSONA_DIR=../workforce/personas
OPENKAREN_WORKFORCE_ROUTING_PROFILE=../workforce/packages/workload-router/routing-profiles/default.json

# Nango-backed provider OAuth for Relayfile stacks.
OPENKAREN_NANGO_BASE_URL=
OPENKAREN_NANGO_SECRET_KEY=
OPENKAREN_NANGO_WEBHOOK_PATH=/webhooks/nango

# Token/context tooling used by coding agents when installed.
# RTK must be Rust Token Killer from rtk-ai/rtk, not the unrelated npm package named rtk.
OPENKAREN_RTK_COMMAND=rtk
OPENKAREN_TILTH_COMMAND=tilth
OPENKAREN_BURN_COMMAND=burn
OPENKAREN_WASH_COMMAND=wash
OPENKAREN_TOKENSAVE_COMMAND=tokensave
